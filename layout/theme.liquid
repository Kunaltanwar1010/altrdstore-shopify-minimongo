{%- capture body_classes -%}
template-{{ template.name | handle }} {{ template.name }}-{{ template.suffix }} {{ template.name | append: '-' | append: handle }}
{%- endcapture -%}

{% liquid
  assign enable_rtl = settings.enable_rtl
  assign language_support_rtl = settings.language_support_rtl
  if enable_rtl and language_support_rtl != blank
    assign shop_locale = localization.language.iso_code
    assign language_support_rtl_list = language_support_rtl | split: ','
    assign is_rtl = language_support_rtl_list | where: shop_locale
    if is_rtl.size > 0
      assign enable_rtl = true
    else
      assign enable_rtl = false
    endif
  endif
%}
<!doctype html>
<html
  class="no-js supports-no-cookies{% if settings.page_transition %} overflow-hidden{% endif %}"
  lang="{{ request.locale.iso_code }}"
  data-template="{{ template.name }}"
  {% if enable_rtl %}
    dir="rtl"
  {% endif %}
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=0">
    <meta name="theme-color" content="{{ settings.color_primary }}">

    {%- liquid
      render 'preload'
      render 'SEO'
      render 'social-meta-tags'
      render 'font-face'
    -%}

    {% render 'critical-css' %}
    {% render 'critical-scripts' %}
    {% render 'custom-code-head' %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'chunk.css' | asset_url | stylesheet_tag }}

    {% render 'style-tags' %}

    <script src="{{ 'vendor.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme-global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'app.min.js' | asset_url }}" defer="defer"></script>

    {%- if settings.animations != 'none' -%}
      <script src="{{ 'animations.min.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Bebas+Neue&display=swap" rel="stylesheet">

    {% liquid
      assign altrd_br = settings.altrd_color_black | color_extract: 'red'
      assign altrd_bg = settings.altrd_color_black | color_extract: 'green'
      assign altrd_bb = settings.altrd_color_black | color_extract: 'blue'
      assign altrd_wr = settings.altrd_color_white | color_extract: 'red'
      assign altrd_wg = settings.altrd_color_white | color_extract: 'green'
      assign altrd_wb = settings.altrd_color_white | color_extract: 'blue'
      assign altrd_htr = settings.altrd_header_bg_top | color_extract: 'red'
      assign altrd_htg = settings.altrd_header_bg_top | color_extract: 'green'
      assign altrd_htb = settings.altrd_header_bg_top | color_extract: 'blue'
      assign altrd_hsr = settings.altrd_header_bg_scrolled | color_extract: 'red'
      assign altrd_hsg = settings.altrd_header_bg_scrolled | color_extract: 'green'
      assign altrd_hsb = settings.altrd_header_bg_scrolled | color_extract: 'blue'
      assign altrd_ftr = settings.altrd_footer_text | color_extract: 'red'
      assign altrd_ftg = settings.altrd_footer_text | color_extract: 'green'
      assign altrd_ftb = settings.altrd_footer_text | color_extract: 'blue'
      assign altrd_ht_opacity = settings.altrd_header_bg_top_opacity | divided_by: 100.0
    %}
    {% style %}
      :root {
        --altrd-black: {{ settings.altrd_color_black }};
        --altrd-black-rgb: {{ altrd_br }}, {{ altrd_bg }}, {{ altrd_bb }};
        --altrd-white: {{ settings.altrd_color_white }};
        --altrd-white-rgb: {{ altrd_wr }}, {{ altrd_wg }}, {{ altrd_wb }};
        --altrd-gray-dark: {{ settings.altrd_color_gray_dark }};
        --altrd-gray-light: {{ settings.altrd_color_gray_light }};
        --altrd-muted: {{ settings.altrd_color_muted }};
        --altrd-border-light: rgba(0,0,0,0.08);
        --altrd-border-dark: rgba(255,255,255,0.10);
        --altrd-header-top-rgb: {{ altrd_htr }}, {{ altrd_htg }}, {{ altrd_htb }};
        --altrd-header-top-opacity: {{ altrd_ht_opacity }};
        --altrd-header-scrolled-rgb: {{ altrd_hsr }}, {{ altrd_hsg }}, {{ altrd_hsb }};
        --altrd-announce-bg: {{ settings.altrd_announce_bg }};
        --altrd-announce-text: {{ settings.altrd_announce_text }};
        --altrd-marquee-bg: {{ settings.altrd_marquee_bg }};
        --altrd-marquee-text-color: {{ settings.altrd_marquee_text_color }};
        --altrd-marquee-speed: {{ settings.altrd_marquee_speed }}s;
        --altrd-footer-bg: {{ settings.altrd_footer_bg }};
        --altrd-footer-text: {{ settings.altrd_footer_text }};
        --altrd-footer-text-rgb: {{ altrd_ftr }}, {{ altrd_ftg }}, {{ altrd_ftb }};
        --altrd-btn-bg: {{ settings.altrd_btn_bg }};
        --altrd-btn-text: {{ settings.altrd_btn_text }};
        --altrd-btn-bg-hover: {{ settings.altrd_btn_bg_hover }};
        --altrd-reveal-duration: {{ settings.altrd_reveal_duration }}ms;
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body
    id="sf-theme"
    class="{{ body_classes }} relative min-h-screen{% if customer %} customer-logged-in{% endif %}{% if settings.page_transition %} overflow-hidden{% endif %}"
    {% if template.name == 'product' %}
      data-product-id="{{ product.id }}"
    {% endif %}
  >
    {% if settings.page_transition %}
      <div class="sf-page-transition">
        <div class="sf-page-transition__spinner">
          <div class="sf-page-transition__spinner-content">
            <div></div>
          </div>
        </div>
      </div>
    {% endif %}
    {%- liquid
      render 'theme-data'
      sections 'header-group'
      render 'scroll-top-button'
    -%}

    <main role="main" id="MainContent">
      {{ content_for_layout }}
    </main>

    {%- sections 'footer-group' -%}

    {% render 'custom-code-body' %}
    {% render 'script-tags' %}
    {% render 'cookie-banner' %}

    <script src="{{ 'quick-view.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-card-swatch.min.js' | asset_url }}" defer="defer"></script>
    {%- if settings.enable_predictive_search -%}
      <script src="{{ 'predictive-search.min.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if linklists['gift-wrapping'].links != blank
      and linklists['gift-wrapping'].links.first.type == 'product_link'
    -%}
      <script src="{{ 'gift-wrapping.min.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- unless template == 'cart' -%}
      {% render 'cart-drawer' %}
    {%- endunless -%}

    <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if(e.isIntersecting){
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.product-card, .shopify-section').forEach(el => {
      el.classList.add('altrd-reveal');
      observer.observe(el);
    });
    </script>
  </body>
</html>
